# Agent memory runtime environment variables
# Copy to .env.agent-memory and fill real values.

# Distill provider/model (can be overridden by ~/.codex/config.toml)
OBSIDIAN_AGENT_MEMORY_SERVER_DISTILL_PROVIDER=codex
OBSIDIAN_AGENT_MEMORY_SERVER_DISTILL_MODEL=gpt-5.2

# Required when provider requires OpenAI auth
OPENAI_API_KEY=

# Optional: stop hook triggers distill asynchronously (fail-open)
OBSIDIAN_AGENT_MEMORY_SERVER_HOOKS_STOP_TRIGGER_DISTILL=false
OBSIDIAN_AGENT_MEMORY_SERVER_HOOKS_REVE_TIMEOUT_MS=12000
OBSIDIAN_AGENT_MEMORY_SERVER_HOOKS_STOP_DISTILL_LIMIT=20
